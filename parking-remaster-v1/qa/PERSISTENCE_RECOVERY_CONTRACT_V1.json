{
  "schema_version": "1.0",
  "status": "PREPARATION_ONLY",
  "purpose": "Define deterministic save/recovery requirements without authorizing gameplay, progression, or production.",
  "authority_boundary": {
    "does_not_pass_gate": true,
    "does_not_authorize_multi_car": true,
    "does_not_authorize_level_3": true,
    "does_not_replace_physical_iphone_review": true
  },
  "storage_model": {
    "preferred": "localStorage",
    "save_namespace": "parking-remaster-v1",
    "required_envelope_fields": ["schema_version", "content_version", "level_id", "level_state", "updated_at"],
    "forbidden_payloads": ["audio_context_state", "transient_animation_frame", "dom_reference", "timer_handle", "raw_telemetry_log"]
  },
  "write_rules": {
    "save_only_at_deterministic_boundaries": true,
    "required_boundaries": ["accepted_player_action", "level_completion", "explicit_restart"],
    "atomic_envelope_write": true,
    "never_block_gameplay_input_on_storage": true
  },
  "recovery_rules": {
    "validate_schema_before_restore": true,
    "validate_content_version_before_restore": true,
    "invalid_or_corrupt_save": "fail_closed_to_known_playable_state",
    "unknown_level_id": "fail_closed_to_known_playable_state",
    "stale_content_version": "migrate_only_with_explicit_tested_migration_otherwise_reset",
    "pagehide_or_visibilitychange": "may_attempt_best_effort_save_but_must_not_be_the_only_save_path",
    "pageshow": "restore_only_from_validated_envelope",
    "audio_recovery_separate_from_game_state_recovery": true
  },
  "test_matrix": [
    "fresh_no_save",
    "valid_current_save",
    "malformed_json",
    "missing_required_field",
    "unknown_schema_version",
    "stale_content_version_without_migration",
    "unknown_level_id",
    "interrupted_session_after_accepted_action",
    "restart_then_reload",
    "level_completion_then_reload"
  ],
  "acceptance_evidence_required_before_release": [
    "automated_envelope_validation_tests",
    "runtime save_restore parity fixture",
    "physical_iPhone reload/background/foreground evidence",
    "corrupt-save fail-closed evidence",
    "tested migration evidence for every supported migration"
  ]
}
