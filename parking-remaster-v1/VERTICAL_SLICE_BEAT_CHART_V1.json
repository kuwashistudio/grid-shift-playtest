  "unresolved_design_decisions": [],
  "resolved_design_decisions": [
    {
      "id": "H1",
      "topic": "exact_visible_fail_mechanic",
      "status": "DECIDED",
      "selected": "shared_exit_conflict",
      "rejected": {
        "pedestrian_crossing": "Rejected for Vertical Slice first fail: player reviews repeatedly report unfair hit attribution, pedestrian stopping/turning into cars, and tempo loss while waiting.",
        "crossing_traffic": "Rejected for first fail: free-running external traffic adds waiting/reaction pressure and a second autonomous system before the core ordering puzzle is mastered."
      },
      "rationale": "Use only player-launched cars and a visible shared merge zone. This minimizes new visual entities, RNG and autonomous behavior while preserving a clear cause-effect link between the player's second conflicting launch and failure.",
      "fairness_contract": [
        "deterministic; no RNG",
        "no countdown timer",
        "no autonomous pedestrian/traffic actor",
        "conflict zone remains visibly telegraphed for the full dangerous interval",
        "collision is triggered only by a player-initiated conflicting launch while that zone is occupied",
        "Level 10 must offer at least one non-conflicting legal action while the zone is occupied so waiting is not mandatory",
        "collision geometry may not exceed visibly understandable vehicle/path geometry",
        "retry returns control quickly; product target <= 1.5 seconds from fail beat to playable reset",
        "fresh player should be able to state the cause after first failure in one sentence"
      ]
    }
  ]
